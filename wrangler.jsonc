/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "middlecat-oidc",
  "main": "src/worker.ts",
  "compatibility_date": "2025-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // Static files (css, js, fonts) are served directly. Everything else goes to the worker.
  "assets": {
    "binding": "ASSETS",
    "directory": "./public",
  },
  "observability": {
    "enabled": true,
  },
  "d1_databases": [
    {
      "binding": "DB1",
      "database_id": "replace-with-your-database-id",
      "database_name": "middlecat_oidc",
      "migrations_dir": "migrations",
    },
  ],
  // Hourly: create upcoming signing keys, remove old ones, delete expired sessions and inactive users
  "triggers": {
    "crons": ["17 * * * *"],
  },
  // Burst limit for /authorize (per IP) and /api/token (per session)
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 30, "period": 60 },
    },
  ],
  // Cloudflare Email Service for sign-in emails (Workers Paid plan, domain onboarded to Cloudflare email).
  // If configured (together with EMAIL_FROM), it's used instead of Resend.
  // "send_email": [{ "name": "EMAIL" }],

  // Keep port 3000 locally, so the demo client works unchanged.
  "dev": {
    "port": 3000,
  },
  /**
   * Configuration (set with `wrangler secret put <NAME>`, or in .dev.vars for local development):
   * BETTER_AUTH_URL       public URL of this MiddleCat (the OIDC issuer), e.g. https://oidc.middlecat.net
   * BETTER_AUTH_SECRET    random secret for signing login cookies
   * KEY_ENCRYPTION_SECRET random secret (at least 32 characters) that encrypts the token signing keys
   *                       (which MiddleCat creates and rotates itself) and keys the email hashes
   * GITHUB_ID / GITHUB_SECRET, GOOGLE_ID / GOOGLE_SECRET   social login
   * EMAIL_FROM            sender of sign-in emails, e.g. "MiddleCat <signin@middlecat.net>"
   * RESEND_API_KEY        email login via Resend (if the Cloudflare EMAIL binding isn't configured)
   * MIDDLECAT_ADMINS      comma separated emails of admins (the /admin page, server budgets)
   */
}
