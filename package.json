{
  "name": "middlecat-cloudflare",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "cf-typegen": "wrangler types",
    "migrate:prepare": "drizzle-kit generate",
    "migrate:up": "wrangler d1 migrations apply middlecat_oidc --remote",
    "migrate:up:local": "wrangler d1 migrations apply middlecat_oidc --local",
    "migrate": "pnpm migrate:prepare && pnpm migrate:up",
    "migrate:local": "pnpm migrate:prepare && pnpm migrate:up:local",
    "generate_env": "node scripts/generate_env.mjs .dev.vars",
    "keys:revoke": "wrangler d1 execute middlecat_oidc --remote --command \"UPDATE signingKey SET revokedAt = CAST(strftime('%s','now') AS INTEGER) * 1000 WHERE revokedAt IS NULL\"",
    "keys:revoke:local": "wrangler d1 execute middlecat_oidc --local --command \"UPDATE signingKey SET revokedAt = CAST(strftime('%s','now') AS INTEGER) * 1000 WHERE revokedAt IS NULL\""
  },
  "dependencies": {
    "better-auth": "^1.7.12",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.13",
    "jose": "^6.2.13",
    "resend": "^6.34.1",
    "ua-parser-js": "^1.0.41",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.6",
    "@fontsource/poppins": "^5.3.0",
    "@types/ua-parser-js": "^0.7.39",
    "drizzle-kit": "^0.31.11",
    "typescript": "^5.9.0",
    "vitest": "^4.1.0",
    "wrangler": "^4.152.0"
  }
}
